  "components": [
    {
      "name": "Marketing primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Forest pill for the main marketing action.",
      "html": "<a class=\"ds-primary\" href=\"#agents\">Meet the agents</a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:54px;padding:12px 39px;background:#15362d;color:#f8f8f8;border-radius:100px;font-size:20px;font-weight:600;text-decoration:none;transition:background .18s ease;font-family:var(--font-sans, \"Instrument Sans\"),sans-serif;}.ds-primary:hover{background:#2a5142}.ds-primary:active{background:#0c251e}.ds-primary:focus-visible{outline:2px solid #35674b;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:.01ms}}"
    },
    {
      "name": "Hiring primary action",
      "kind": "button",
      "refersTo": "button-hire",
      "description": "Main progression action in the hiring form.",
      "html": "<button class=\"ds-hire\">Continue</button>",
      "css": ".ds-hire{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 26px;background:#15362d;color:#fff;border:1px solid #15362d;border-radius:100px;font-size:15px;font-weight:600;cursor:pointer;transition:background-color .15s ease,color .15s ease,border-color .15s ease;font-family:var(--font-sans, \"Instrument Sans\"),sans-serif;}.ds-hire:hover:not(:disabled){background:#264d3d;border-color:#264d3d}.ds-hire:focus-visible{outline:3px solid #49683b;outline-offset:4px;}.ds-hire:disabled{color:#5b695c;background:#e0e5da;border-color:#e0e5da;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-hire{transition:none}}"
    },
    {
      "name": "Role option",
      "kind": "card",
      "refersTo": "role-option",
      "description": "A selectable radio row with descriptive copy.",
      "html": "<label class=\"ds-option\"><input type=\"radio\" name=\"ds-role\" checked /><span><strong>Recruiting Agent</strong><span>Build a shortlist for your review.</span></span></label>",
      "css": ".ds-option{display:flex;align-items:flex-start;gap:16px;border:1px solid #d9dfd9;background:#fff;border-radius:8px;padding:19px 20px;cursor:pointer;color:#15362d;transition:background-color .15s ease,border-color .15s ease;font-family:var(--font-sans, \"Instrument Sans\"),sans-serif;}.ds-option:has(input:checked){background:#eef3e4;border-color:#6c825f}.ds-option:hover{border-color:#829084;background:#f0f3eb}.ds-option input{width:18px;height:18px;margin:3px 0 0;accent-color:#15362d}.ds-option input:focus-visible{outline:3px solid #49683b;outline-offset:4px;}.ds-option>span{display:grid;gap:5px;min-width:0}.ds-option strong{font-size:16px;font-weight:650}.ds-option>span>span{font-size:14px;line-height:1.6;color:#536456}@media(prefers-reduced-motion:reduce){.ds-option{transition:none}}"
    },
    {
      "name": "Recommendation badge",
      "kind": "chip",
      "refersTo": "recommended",
      "description": "Noninteractive engine recommendation.",
      "html": "<span class=\"ds-recommended\">Recommended</span>",
      "css": ".ds-recommended{display:inline-block;font-size:12px;background:#dce8c3;color:#15362d;padding:4px 10px;border-radius:20px;font-family:var(--font-sans, \"Instrument Sans\"),sans-serif;}"
    },
    {
      "name": "Sample sheet",
      "kind": "card",
      "refersTo": "sample-sheet",
      "description": "Flat example deliverable panel from an agent profile.",
      "html": "<article class=\"ds-sheet\"><h3>Example handoff</h3><ul><li>Messages grouped for review</li><li>Draft replies ready to edit</li></ul></article>",
      "css": ".ds-sheet{border:1px solid #c8d3c9;padding:28px;background:#fff;color:#15362d;font-family:var(--font-sans, \"Instrument Sans\"),sans-serif;}.ds-sheet h3{margin:0;padding-bottom:20px;border-bottom:1px solid #d6dfd7;font-family:var(--font-team,Geom),sans-serif;font-size:19px;line-height:1.4;letter-spacing:-.02em;font-weight:600}.ds-sheet ul{margin:20px 0 0;padding:0;list-style:none;display:grid;gap:18px;font-size:16px;line-height:1.55}"
    },
    {
      "name": "Functional primary action",
      "kind": "button",
      "refersTo": "workspace-primary",
      "description": "Themed auth progression action.",
      "html": "<button class=\"ds-functional-primary\">Continue</button>",
      "css": ".ds-functional-primary{font-family:var(--font-sans,\"Instrument Sans\"),sans-serif;background:var(--c-lime);color:var(--c-ink);border:0;border-radius:100px;padding:14px 24px;min-height:50px;font-size:16px;font-weight:600;cursor:pointer}.ds-functional-primary:hover{background:var(--c-lime-hover)}.ds-functional-primary:focus-visible{outline:2px solid var(--c-accent);outline-offset:4px;}.ds-functional-primary:disabled{opacity:.6;cursor:wait}"
    },
    {
      "name": "Functional secondary action",
      "kind": "button",
      "refersTo": "workspace-secondary",
      "description": "Outlined secondary authentication action.",
      "html": "<button class=\"ds-functional-secondary\">Continue with Google</button>",
      "css": ".ds-functional-secondary{font-family:var(--font-sans,\"Instrument Sans\"),sans-serif;border:1px solid var(--c-border-field);border-radius:100px;padding:12px 18px;min-height:48px;background:transparent;color:var(--c-text);font-size:15px;cursor:pointer}.ds-functional-secondary:hover:enabled{background:var(--c-hover)}.ds-functional-secondary:focus-visible{outline:2px solid var(--c-accent);outline-offset:4px;}.ds-functional-secondary:disabled{cursor:not-allowed}"
    },
    {
      "name": "Functional field",
      "kind": "input",
      "refersTo": "workspace-field",
      "description": "Explicit label and themed field boundary.",
      "html": "<label class=\"ds-functional-field\">Email<input type=\"email\" placeholder=\"you@example.com\" /></label>",
      "css": ".ds-functional-field{font-family:var(--font-sans,\"Instrument Sans\"),sans-serif;display:grid;gap:8px;font-size:13px;font-weight:600;color:var(--c-text2)}.ds-functional-field input{font-family:var(--font-sans,\"Instrument Sans\"),sans-serif;border:1px solid var(--c-border-field);border-radius:7px;background:var(--c-panel);color:var(--c-text);padding:13px 15px;font-size:16px;caret-color:var(--c-accent)}.ds-functional-field input::placeholder{color:var(--c-muted)}.ds-functional-field input:focus-visible{outline:2px solid var(--c-accent);outline-offset:4px;}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "workspace-navigation-selected",
      "description": "Selected sidebar row with a persistent text label and shared stroke icon.",
      "html": "<nav aria-label=\"Workspace\"><button class=\"ds-workspace-nav\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg>Overview</button></nav>",
