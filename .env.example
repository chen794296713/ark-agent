# =====================================================================
# ArkAgent — environment template. Copy to `.env` and fill in real values.
# Never commit a real `.env` (it is git-ignored).
# =====================================================================

# ---- Database (Postgres) ----------------------------------------------------
# Pooled connection (e.g. pgbouncer transaction mode) used by the app at runtime.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/arkagent?sslmode=require
# Direct (non-pooled) connection used for migrations / drizzle-kit. May equal
# DATABASE_URL if you do not use a connection pooler.
DIRECT_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/arkagent?sslmode=require

# ---- Authentication ---------------------------------------------------------
# RESERVED — nothing reads this today. Session tokens are 32 random bytes and
# only their SHA-256 is stored (lib/auth.ts), so there is no signing key to
# configure. Kept for a future signed-cookie scheme; leaving it unset is safe.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
SESSION_COOKIE_NAME=ark_session
SESSION_TTL_DAYS=30

# ---- Agent Manager integration ----------------------------------------------
# Which runtime backs an agent:
#   live   call the real Agent Manager (requires AGENT_MANAGER_BASE_URL)
#   mock   built-in in-process simulator — development and CI only
#   unset  inferred: live when a BASE_URL is present, mock in development,
#          and UNCONFIGURED in production (agent routes return 503)
#
# Production never falls back to the simulator by accident. A simulated fleet
# reports every agent as `working`, invents VM ids and uptimes, and answers chat
# with canned text while the customer is billed for a seat behind which no
# machine was ever started — a failure that looks exactly like success. Running
# it on a production host is still possible, but only by writing `mock` here.
AGENT_MANAGER_MODE=mock
AGENT_MANAGER_BASE_URL=http://localhost:4000
# Bearer token ArkAgent sends to the Agent Manager on every request.
AGENT_MANAGER_API_KEY=replace-with-agent-manager-api-key
# Shared secret the Agent Manager uses to sign webhooks back to ArkAgent (HMAC-SHA256).
AGENT_MANAGER_WEBHOOK_SECRET=replace-with-webhook-shared-secret

# ---- OpenClaw Manager API ---------------------------------------------------
# Base URL of the OpenClaw Manager service
OPENCLAW_MANAGER_API_URL=https://clawmanager.lightark.cc
# Bearer token for OpenClaw Manager API
OPENCLAW_MANAGER_API_KEY=replace-with-openclaw-manager-api-key
# Set to 1 to log Manager request URLs, query parameters, and JSON bodies.
OPENCLAW_DEBUG_LOG=0
# Both values above are REQUIRED in production: an unset key sends `Bearer ` to
# a hardcoded default host and every provisioning call fails as a 401, which
# reads as an upstream outage rather than a missing variable.

# ---- Seeding ----------------------------------------------------------------
# `npm run db:seed` writes reference data only (plans, agent roles, the platform
# admin). Set SEED_DEMO=1 — or run `npm run db:seed:demo` — to also build the
# demo workspace (login `demo` / `demo123`, four agents, billing seats, paid
# invoices). It is refused outright when NODE_ENV=production: the credential is
# guessable and everything behind it is reconfigurable by whoever signs in.
SEED_DEMO=0

# Comma-separated allowlist of harnesses this deployment offers, from
# openclaw | hermes | codex | deepseek.
#   unset          every harness the OpenClaw Manager can actually provision,
#                  which today is openclaw and hermes — it has no category_id
#                  for codex or deepseek yet, and a harness listed here that it
#                  cannot provision is filtered out rather than trusted
#   a list         the intersection of that list and what is provisionable
#   set but empty  NOTHING — an empty gate fails closed, not open
# Use it to dark-launch a harness: present in the enum and the schema, absent
# from every picker, until the runtime team assigns it an id.
# ATG_ENABLED_HARNESSES=openclaw,hermes

# ---- Scheduled work ---------------------------------------------------------
# Shared secret for the cron endpoints (/api/cron/schedules, /api/skills/sync).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`; the routes
# compare it with timingSafeEqual and FAIL CLOSED when it is unset — an
# unauthenticated tick could fire every schedule in the database on demand.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# ---- Feature flags ----------------------------------------------------------
# `/directions` is an internal brand-direction review page that was linked from
# the public landing footer and the dashboard sidebar. Unset, the route 404s and
# both links disappear. The DirectionSwitcher control is unaffected.
NEXT_PUBLIC_SHOW_DIRECTIONS=0

# ---- LLM (OpenRouter) -------------------------------------------------------
# Powers agent chat replies and hire-brief auto-generation. When unset, the app
# falls back to a canned mock reply / the role's seeded default brief.
OPENROUTER_API_KEY=replace-with-openrouter-api-key
# Model id routed by OpenRouter, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet.
# An "openrouter/" prefix (openrouter/openai/gpt-4o-mini) is accepted and stripped.
# Verify the exact id with `npm run llm:check` — an unknown id fails with a 400.
LLM_MODEL=openai/gpt-4o-mini
# Optional: app name reported to OpenRouter (X-Title). Defaults to "ArkAgent".
OPENROUTER_APP_TITLE=ArkAgent
# Optional: override the OpenRouter base URL (defaults to the public endpoint).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Payments — mode switch -------------------------------------------------
# Leave UNSET and each provider detects itself: Stripe goes live when
# STRIPE_SECRET_KEY is present, Alipay when ALIPAY_ENABLED is true AND
# ALIPAY_CALLBACK_SECRET is set. Outside production, a provider with no
# credentials falls back to `mock` and fulfils checkouts inline (subscription +
# paid invoice in the same request), so the demo works with nothing but a
# database.
# In production that fallback is DELIBERATELY not available: an unconfigured
# provider returns 503 instead, because inline fulfilment would hand out paid
# seats for free to anyone who can register. Setting `mock` here is the explicit
# opt-in that overrides that, and no real deployment should ever set it.
# PAYMENTS_MODE=mock

# ---- Payments — Stripe (international / USD) --------------------------------
# Secret API key. Its presence is what switches Stripe to live mode. The flow is
# entirely server-side (hosted Checkout), so the publishable key is never used.
# Test keys start sk_test_; use a restricted key in production.
# Left COMMENTED OUT so a fresh clone starts in mock mode and the demo works with
# nothing but a database. Uncomment with a real key to switch Stripe live.
# STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret-key
# Signing secret of the webhook endpoint pointing at
# <NEXT_PUBLIC_APP_URL>/api/webhooks/stripe. Without it every webhook is
# rejected 400 — payments are taken and no seat is ever granted.
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints its own
# whsec_ for local use; it is NOT the one from the Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret
# OPTIONAL: recurring Price ids, one per tier per cycle. Leave unset and the
# session is built from inline price_data using the ladder in lib/pricing.ts —
# no Products or Prices need to exist in Stripe at all. Set them only if you want
# prices managed in the Dashboard and per-plan revenue reporting; remember Stripe
# Prices are immutable, so a price change means a new id here.
# STRIPE_PRICE_ASSOCIATE_MONTHLY=price_...
# STRIPE_PRICE_ASSOCIATE_ANNUAL=price_...
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
# STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_...
# STRIPE_PRICE_DIRECTOR_MONTHLY=price_...
# STRIPE_PRICE_DIRECTOR_ANNUAL=price_...
# OPTIONAL: comma-separated payment methods. Leave unset (recommended) and the
# session offers whatever is enabled in Settings → Payment methods. Setting it
# opts out of Stripe's automatic methods and freezes the list into a deploy — and
# every method listed must be activated on the account or session creation fails.
# STRIPE_PAYMENT_METHOD_TYPES=card,link
# OPTIONAL: free-trial days on the subscription. 0 or unset = no trial.
# STRIPE_TRIAL_DAYS=14
# OPTIONAL: pins the Stripe API version so an SDK bump cannot change payload
# shapes underneath the webhook. Match this to the version set on the webhook
# endpoint in the Dashboard. Defaults to DEFAULT_STRIPE_API_VERSION.
# STRIPE_API_VERSION=2026-08-26.dahlia

# ---- Payments — Alipay (China / CNY, via the GoHire gateway) ----------------
# This is NOT a direct Alipay merchant integration: orders are created at the
# GoHire gateway, which holds the Alipay credentials. You need no Alipay app_id
# and no RSA keypair — but you DO need the gateway operator to onboard you.
# See docs/PAYMENTS.md for exactly what to ask them for.
# `true` or `1` switches Alipay to live; anything else (including unset) = mock.
ALIPAY_ENABLED=false
# Gateway order-create endpoint. Set explicitly rather than trusting the default.
ALIPAY_API_URL=https://worker.gohire.top/payment/payment/create
# Tenant identifier the gateway routes and attributes orders on. Confirm with the
# operator whether you keep `gohire` or get your own code — the wrong value means
# your orders land in someone else's ledger.
ALIPAY_PLATFORM=gohire
# REQUIRED IN PRODUCTION. The gateway does not sign its callbacks, so this token
# is baked into the notify_url we hand it and demanded back on every callback —
# it is the only thing preventing a forged TRADE_SUCCESS from granting a free
# seat. Unset in production, the callback endpoint rejects everything (fails
# closed). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left COMMENTED OUT on purpose: a placeholder value here would be a shared,
# publicly known secret the moment anyone enabled Alipay without editing it.
# Unset, Alipay simply refuses to go live, which is the safe failure.
# ALIPAY_CALLBACK_SECRET=

# ---- App --------------------------------------------------------------------
# Public origin. Payment return URLs and the Alipay notify_url are built from it,
# so in production it MUST be the real public HTTPS origin — the app throws on
# boot rather than silently minting localhost URLs that no provider can reach.
# For local Alipay testing, point this at a tunnel (cloudflared / ngrok);
# localhost will never receive a gateway callback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info

# Usage accounting asks for token counts on streamed LLM calls. Set to 0 only if
# a proxied OPENROUTER_BASE_URL rejects the stream_options field.
# OPENROUTER_STREAM_USAGE=1

# ---- Platform admin -----------------------------------------------------------
# Bootstrapped by `npm run db:seed`. With none of these set the seed creates
# admin@iagent.cc / Lightark@1 — a password that is public in the source tree.
# SET ADMIN_PASSWORD before exposing a deployment to the internet.
ADMIN_EMAIL=admin@iagent.cc
# ADMIN_PASSWORD=replace-with-a-real-password
ADMIN_NAME=Platform Admin

# ---- Sign in with Google ------------------------------------------------------
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Unset = the Google button renders disabled instead of failing at the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- WeChat login -------------------------------------------------------------
# 网站应用 (open.weixin.qq.com) drives the desktop QR flow; 公众号 credentials
# drive the in-WeChat flow. Either pair may be set on its own.
# Authorized callback domain must be the host of NEXT_PUBLIC_APP_URL.
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
